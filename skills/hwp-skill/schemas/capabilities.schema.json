{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/contentriumkorea/hwp-skill/blob/main/skills/hwp-skill/schemas/capabilities.schema.json",
  "title": "HWP Backend Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionMode",
    "backends"
  ],
  "properties": {
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planVersions", "defaultPlanVersion", "defaultOutputFormat", "requiresHancomForHwpx", "requiresSecurityModuleForImages", "nativeRenderingVerified", "generateCommand", "validateCommand", "scopedEditCommand", "features", "conditions"],
      "properties": {
        "planVersions": {"type":"array", "items":{"enum":["1.0","2.0"]}, "uniqueItems":true},
        "defaultPlanVersion": {"const":"2.0"},
        "defaultOutputFormat": {"const":"hwpx"},
        "requiresHancomForHwpx": {"const":false},
        "requiresSecurityModuleForImages": {"const":false},
        "nativeRenderingVerified": {"const":false},
        "generateCommand": {"const":"generate -NewDocument"},
        "validateCommand": {"const":"validate-generate-plan"},
        "scopedEditCommand": {"const":"edit-hwpx"},
        "features": {"type":"array", "items":{"$ref":"#/definitions/authoringFeature"}},
        "conditions": {"type":"object", "additionalProperties":{"type":"string"}}
      }
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "executionMode": {
      "enum": [
        "silent",
        "isolated-native",
        "interactive"
      ]
    },
    "backends": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "additionalItems": false,
      "items": [
        {
          "$ref": "#/definitions/hwpxDirectBackend"
        },
        {
          "$ref": "#/definitions/hwpPortableBackend"
        },
        {
          "$ref": "#/definitions/hancomIsolatedBackend"
        },
        {
          "$ref": "#/definitions/hancomInteractiveBackend"
        }
      ]
    }
  },
  "definitions": {
    "authoringFeature": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","read","create","edit","structure","visual"],
      "properties": {
        "id":{"type":"string"},
        "read":{"$ref":"#/definitions/supportState"},
        "create":{"$ref":"#/definitions/supportState"},
        "edit":{"$ref":"#/definitions/supportState"},
        "structure":{"$ref":"#/definitions/supportState"},
        "visual":{"$ref":"#/definitions/supportState"}
      }
    },
    "supportState":{"enum":["supported","conditional","unsupported"]},
    "hwpxDirectBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "available",
        "formats",
        "operations",
        "requiresGui",
        "isolation",
        "reason"
      ],
      "properties": {
        "id": {
          "const": "hwpx-direct"
        },
        "available": {
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            {
              "const": "HWPX-ZIP"
            }
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false,
          "items": [
            {
              "const": "inspect"
            },
            {
              "const": "generate"
            }
          ]
        },
        "requiresGui": {
          "const": false
        },
        "isolation": {
          "const": "none"
        },
        "reason": {
          "const": "HWPX ZIP/XML direct inspection and generation are built in; Hancom is not used for content writing."
        }
      }
    },
    "hwpPortableBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "available",
        "formats",
        "operations",
        "requiresGui",
        "isolation",
        "reason"
      ],
      "properties": {
        "id": {
          "const": "hwp-portable"
        },
        "available": {
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            {
              "const": "HWP-BINARY"
            }
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            {
              "const": "inspect"
            }
          ]
        },
        "requiresGui": {
          "const": false
        },
        "isolation": {
          "const": "none"
        },
        "reason": {
          "const": "Built-in read-only HWP 5.x inspection uses the Windows OLE compound-file API and does not require Hancom."
        }
      }
    },
    "hancomIsolatedBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "available",
        "formats",
        "operations",
        "requiresGui",
        "isolation",
        "reason"
      ],
      "properties": {
        "id": {
          "const": "hancom-isolated"
        },
        "available": {
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            {
              "const": "HWP-BINARY"
            }
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "additionalItems": false,
          "items": [
            {
              "const": "inspect"
            },
            {
              "const": "generate"
            },
            {
              "const": "apply"
            },
            {
              "const": "batch"
            },
            {
              "const": "verify"
            },
            {
              "const": "export"
            }
          ]
        },
        "requiresGui": {
          "const": true
        },
        "isolation": {
          "const": "separate-session"
        },
        "reason": {
          "const": "Isolated native worker support will be wired in without using local COM fallback."
        }
      }
    },
    "hancomInteractiveBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "available",
        "formats",
        "operations",
        "requiresGui",
        "isolation",
        "reason"
      ],
      "properties": {
        "id": {
          "const": "hancom-interactive"
        },
        "available": {
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            {
              "const": "HWP-BINARY"
            }
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "additionalItems": false,
          "items": [
            {
              "const": "inspect"
            },
            {
              "const": "generate"
            },
            {
              "const": "apply"
            },
            {
              "const": "batch"
            },
            {
              "const": "verify"
            },
            {
              "const": "export"
            }
          ]
        },
        "requiresGui": {
          "const": true
        },
        "isolation": {
          "const": "current-session"
        },
        "reason": {
          "const": "Interactive Hancom automation depends on local COM registration only."
        }
      }
    }
  }
}
