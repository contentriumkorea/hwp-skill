{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/contentriumkorea/hwp-skill/blob/main/skill/hwp-skill/schemas/inspection.schema.json",
  "title": "HWP 스킬 검사 결과",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status", "path", "sha256", "detectedKind", "text",
    "fields", "controls", "tables", "resources", "paragraphs", "sections",
    "layout", "pageCount", "warnings"
  ],
  "properties": {
    "status": {
      "enum": ["PASS", "PASS_WITH_WARNINGS", "BLOCKED", "FAILED"]
    },
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "detectedKind": { "enum": ["HWP-BINARY", "HWPX-ZIP", "UNKNOWN"] },
    "text": { "type": "string" },
    "fields": { "type": "object" },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ctrlId"],
        "properties": {
          "ctrlId": { "type": "string" },
          "userDesc": { "type": "string" },
          "instanceId": {}
        },
        "additionalProperties": true
      }
    },
    "tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/table" }
    },
    "resources": { "$ref": "#/$defs/resources" },
    "paragraphs": {
      "type": "array",
      "items": { "$ref": "#/$defs/paragraph" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "layout": { "$ref": "#/$defs/layout" },
    "pageCount": { "type": "integer", "minimum": 0 },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": ["raw", "point", "millimeter"],
      "properties": {
        "raw": { "type": "integer" },
        "point": { "type": "number" },
        "millimeter": { "type": "number" }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["fonts", "borderFills", "charShapes", "paraShapes"],
      "properties": {
        "fonts": { "type": "array", "items": { "type": "object", "required": ["id", "language", "name"], "additionalProperties": true } },
        "borderFills": { "type": "array", "items": { "type": "object", "required": ["id", "borders", "fill"], "additionalProperties": true } },
        "charShapes": { "type": "array", "items": { "type": "object", "required": ["id", "fontSizePt", "attributes", "resolvedFontNames"], "additionalProperties": true } },
        "paraShapes": { "type": "array", "items": { "type": "object", "required": ["id", "alignment", "margins", "indent", "lineSpacing"], "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "charShapeRun": {
      "type": "object",
      "required": ["start", "charShapeId"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "charShapeId": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "lineSegment": {
      "type": "object",
      "required": [
        "index", "textStart", "verticalPosition", "lineHeight", "textHeight",
        "baseline", "lineSpacing", "columnStart", "segmentWidth", "flagsRaw",
        "isPageFirst", "isColumnFirst", "isEmpty", "isLineFirst", "isLineLast", "text"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "textStart": { "type": "integer", "minimum": 0 },
        "verticalPosition": { "$ref": "#/$defs/measurement" },
        "lineHeight": { "$ref": "#/$defs/measurement" },
        "textHeight": { "$ref": "#/$defs/measurement" },
        "baseline": { "$ref": "#/$defs/measurement" },
        "lineSpacing": { "$ref": "#/$defs/measurement" },
        "columnStart": { "$ref": "#/$defs/measurement" },
        "segmentWidth": { "$ref": "#/$defs/measurement" },
        "flagsRaw": { "type": "integer", "minimum": 0 },
        "isPageFirst": { "type": "boolean" },
        "isColumnFirst": { "type": "boolean" },
        "isEmpty": { "type": "boolean" },
        "isLineFirst": { "type": "boolean" },
        "isLineLast": { "type": "boolean" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "storedLine": {
      "type": "object",
      "required": ["index", "textStart", "textEnd", "text"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "textStart": { "type": "integer", "minimum": 0 },
        "textEnd": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "paragraph": {
      "type": "object",
      "required": [
        "index", "section", "text", "rawCharacterCount", "declaredCharacterCount",
        "paraShapeId", "styleId", "charShapeRuns", "lineSegments", "storedLines"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "section": { "type": "string", "minLength": 1 },
        "recordLevel": { "type": ["integer", "null"], "minimum": 0 },
        "text": { "type": "string" },
        "rawCharacterCount": { "type": "integer", "minimum": 0 },
        "declaredCharacterCount": { "type": "integer", "minimum": 0 },
        "paraShapeId": { "type": "integer", "minimum": 0 },
        "styleId": { "type": "integer", "minimum": 0 },
        "charShapeRuns": { "type": "array", "items": { "$ref": "#/$defs/charShapeRun" } },
        "lineSegments": { "type": "array", "items": { "$ref": "#/$defs/lineSegment" } },
        "storedLines": { "type": "array", "items": { "$ref": "#/$defs/storedLine" } }
      },
      "additionalProperties": true
    },
    "pageDefinition": {
      "type": "object",
      "required": ["index", "orientation", "width", "height", "margins"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "orientation": { "enum": ["PORTRAIT", "LANDSCAPE"] },
        "width": { "$ref": "#/$defs/measurement" },
        "height": { "$ref": "#/$defs/measurement" },
        "margins": {
          "type": "object",
          "required": ["left", "right", "top", "bottom", "header", "footer", "gutter"],
          "additionalProperties": { "$ref": "#/$defs/measurement" }
        }
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["index", "name", "paragraphStartIndex", "paragraphCount", "pageDefinitions", "storedPageFirstLineCount"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "paragraphStartIndex": { "type": "integer", "minimum": 0 },
        "paragraphCount": { "type": "integer", "minimum": 0 },
        "pageDefinitions": { "type": "array", "items": { "$ref": "#/$defs/pageDefinition" } },
        "storedPageFirstLineCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["source", "storedLineLayoutAvailable", "lineSegmentCount", "pageCountSource", "exactRenderingVerified"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "storedLineLayoutAvailable": { "type": "boolean" },
        "lineSegmentCount": { "type": "integer", "minimum": 0 },
        "pageCountSource": { "type": "string", "minLength": 1 },
        "exactRenderingVerified": { "const": false }
      },
      "additionalProperties": true
    },
    "margins": {
      "type": "object",
      "required": ["left", "right", "top", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": 0 },
        "right": { "type": "integer", "minimum": 0 },
        "top": { "type": "integer", "minimum": 0 },
        "bottom": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "address": {
      "type": "object",
      "required": ["rowAddress", "columnAddress"],
      "properties": {
        "rowAddress": { "type": "integer", "minimum": 0 },
        "columnAddress": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "gridSlot": {
      "type": "object",
      "required": ["cellIndex", "isAnchor", "mergedInto"],
      "properties": {
        "cellIndex": { "type": "integer", "minimum": 0 },
        "isAnchor": { "type": "boolean" },
        "mergedInto": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/address" }
          ]
        }
      },
      "additionalProperties": true
    },
    "cell": {
      "type": "object",
      "required": [
        "index", "id", "name", "rowAddress", "columnAddress", "rowSpan", "columnSpan",
        "width", "height", "margins", "borderFillId", "paragraphCountDeclared",
        "paragraphs", "text", "textDirectionCode", "textDirection",
        "lineWrapCode", "lineWrap", "verticalAlignmentCode", "verticalAlignment", "dirty"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "rowAddress": { "type": "integer", "minimum": 0 },
        "columnAddress": { "type": "integer", "minimum": 0 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "margins": { "$ref": "#/$defs/margins" },
        "borderFillId": { "type": "integer", "minimum": 0 },
        "paragraphCountDeclared": { "type": "integer", "minimum": 0 },
        "paragraphs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "text": { "type": "string" },
        "cellFlagsRaw": { "type": ["integer", "null"], "minimum": 0 },
        "listPropertiesRaw": { "type": ["integer", "null"], "minimum": 0 },
        "textDirectionCode": { "type": ["integer", "null"], "minimum": 0 },
        "textDirection": { "type": "string" },
        "lineWrapCode": { "type": ["integer", "null"], "minimum": 0 },
        "lineWrap": { "type": "string" },
        "verticalAlignmentCode": { "type": ["integer", "null"], "minimum": 0 },
        "verticalAlignment": { "type": "string" },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "validZone": {
      "type": "object",
      "required": [
        "index", "startColumnAddress", "startRowAddress",
        "endColumnAddress", "endRowAddress", "borderFillId"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "startColumnAddress": { "type": "integer", "minimum": 0 },
        "startRowAddress": { "type": "integer", "minimum": 0 },
        "endColumnAddress": { "type": "integer", "minimum": 0 },
        "endRowAddress": { "type": "integer", "minimum": 0 },
        "borderFillId": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "tableProperties": {
      "type": "object",
      "required": ["raw", "pageBreakCode", "pageBreak", "repeatHeader", "noAdjust"],
      "properties": {
        "raw": { "type": ["integer", "null"], "minimum": 0 },
        "pageBreakCode": { "type": ["integer", "null"], "minimum": 0 },
        "pageBreak": { "type": "string" },
        "repeatHeader": { "type": "boolean" },
        "noAdjust": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "table": {
      "type": "object",
      "required": [
        "index", "section", "source", "recordLevel", "rowCount", "columnCount",
        "cellSpacing", "innerMargins", "rowSizes", "borderFillId", "properties",
        "validZones", "cells", "grid"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "section": { "type": "string", "minLength": 1 },
        "source": { "enum": ["hwp-portable", "hwpx-package"] },
        "recordLevel": { "type": ["integer", "null"], "minimum": 0 },
        "rowCount": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "columnCount": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "cellSpacing": { "type": "integer", "minimum": 0 },
        "innerMargins": { "$ref": "#/$defs/margins" },
        "rowSizes": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          }
        },
        "borderFillId": { "type": "integer", "minimum": 0 },
        "properties": { "$ref": "#/$defs/tableProperties" },
        "validZones": {
          "type": "array",
          "items": { "$ref": "#/$defs/validZone" }
        },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        },
        "grid": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "#/$defs/gridSlot" }
              ]
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
