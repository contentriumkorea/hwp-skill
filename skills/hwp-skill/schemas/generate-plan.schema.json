{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/contentriumkorea/hwp-skill/blob/main/skill/hwp-skill/schemas/generate-plan.schema.json",
  "title": "HWP 스킬 새 문서 계획",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "content"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string" },
    "document": { "$ref": "#/$defs/document" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/paragraph" },
          { "$ref": "#/$defs/table" },
          { "$ref": "#/$defs/field" },
          { "$ref": "#/$defs/image" },
          { "$ref": "#/$defs/pageBreak" }
        ]
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 256 },
        "fontSizePt": { "type": "number", "minimum": 1, "maximum": 409.6 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "textColor": { "$ref": "#/$defs/color" }
      }
    },
    "paragraphStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": { "enum": ["JUSTIFY", "LEFT", "RIGHT", "CENTER", "DISTRIBUTE", "DISTRIBUTE_SPACE"] },
        "lineSpacingPercent": { "type": "integer", "minimum": 50, "maximum": 500 },
        "marginBeforeMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "marginAfterMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "leftMarginMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "rightMarginMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "indentMm": { "type": "number", "minimum": -1000, "maximum": 1000 }
      }
    },
    "tableStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "borderType": { "enum": ["NONE", "SOLID", "DASH", "DOT", "DASH_DOT", "DASH_DOT_DOT", "LONG_DASH", "CIRCLE", "DOUBLE", "THIN_THICK", "THICK_THIN", "THIN_THICK_THIN", "WAVE", "DOUBLE_WAVE"] },
        "borderWidthMm": { "type": "number", "minimum": 0.05, "maximum": 10 },
        "borderColor": { "$ref": "#/$defs/color" },
        "fillColor": {
          "anyOf": [
            { "$ref": "#/$defs/color" },
            { "const": "none" }
          ]
        },
        "cellPaddingMm": { "type": "number", "minimum": 0, "maximum": 50 }
      }
    },
    "pageMargins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leftMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "rightMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "topMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "bottomMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "headerMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "footerMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "gutterMm": { "type": "number", "minimum": 0, "maximum": 500 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": { "enum": ["PORTRAIT", "LANDSCAPE"] },
        "widthMm": { "type": "number", "minimum": 10, "maximum": 2000 },
        "heightMm": { "type": "number", "minimum": 10, "maximum": 2000 },
        "margins": { "$ref": "#/$defs/pageMargins" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "$ref": "#/$defs/page" },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "paragraphStyle": { "$ref": "#/$defs/paragraphStyle" },
        "tableStyle": { "$ref": "#/$defs/tableStyle" }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string" },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "paragraphStyle": { "$ref": "#/$defs/paragraphStyle" }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "text"],
      "properties": {
        "row": { "type": "integer", "minimum": 1, "maximum": 100 },
        "column": { "type": "integer", "minimum": 1, "maximum": 100 },
        "text": { "type": "string" },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "paragraphStyle": { "$ref": "#/$defs/paragraphStyle" },
        "style": { "$ref": "#/$defs/tableStyle" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows", "columns", "cells"],
      "properties": {
        "type": { "const": "table" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 100 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCell" }
        },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "paragraphStyle": { "$ref": "#/$defs/paragraphStyle" },
        "style": { "$ref": "#/$defs/tableStyle" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "value"],
      "properties": {
        "type": { "const": "field" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "label": { "type": "string" },
        "memo": { "type": "string" },
        "display": { "type": "string" },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "paragraphStyle": { "$ref": "#/$defs/paragraphStyle" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "image" },
        "path": { "type": "string", "minLength": 1 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "pageBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "page-break" }
      }
    }
  }
}
