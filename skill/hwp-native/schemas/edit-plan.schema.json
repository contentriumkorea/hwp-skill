{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gb-consumer/hwp-native-skill/blob/main/skill/hwp-native/schemas/edit-plan.schema.json",
  "title": "HWP 네이티브 편집 계획",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "approvedAdvanced", "operations"],
  "allOf": [
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["delete-range", "add-table-row", "set-section", "merge-documents"]
                }
              }
            }
          }
        },
        "required": ["operations"]
      },
      "then": {
        "properties": {
          "approvedAdvanced": { "const": true }
        }
      }
    }
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "approvedAdvanced": {
      "type": "boolean"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "risk", "target", "expectedMatches", "onFailure", "verify"],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "enum": ["delete-range", "add-table-row", "set-section", "merge-documents"] }
            },
            "required": ["type"]
          },
          "then": { "properties": { "risk": { "const": "advanced" } } },
          "else": { "properties": { "risk": { "const": "safe" } } }
        },
        {
          "if": { "properties": { "risk": { "const": "safe" } }, "required": ["risk"] },
          "then": { "properties": { "expectedMatches": { "const": 1 } } }
        },
        {
          "if": { "properties": { "type": { "const": "set-field" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["fieldName"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "set-table-cell" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["tableIndex", "row", "column"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "add-table-row" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["tableIndex", "afterRow"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "insert-table" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["rows", "columns"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "insert-image" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["imagePath"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "replace-image" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["controlIndex", "imagePath"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "apply-char-style" } }, "required": ["type"] },
          "then": {
            "properties": {
              "target": {
                "anyOf": [
                  { "required": ["heightPt"] },
                  { "required": ["bold"] },
                  { "required": ["italic"] }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "apply-para-style" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["align"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "set-section" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["orientation"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "set-header-footer" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["kind", "text"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "add-bookmark" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["name"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "add-hyperlink" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["url"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "add-caption" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["controlId", "controlIndex", "text"] } } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["add-footnote", "add-endnote"] } },
            "required": ["type"]
          },
          "then": { "properties": { "target": { "required": ["text"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "build-toc" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["headingAnchors"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "merge-documents" } }, "required": ["type"] },
          "then": { "properties": { "target": { "required": ["paths"] } } }
        }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "replace-text", "insert-before", "insert-after", "delete-range",
            "set-field", "set-table-cell", "add-table-row", "insert-table",
            "insert-image", "replace-image", "apply-char-style", "apply-para-style",
            "insert-page-break", "set-section", "set-header-footer", "set-page-number",
            "add-bookmark", "add-hyperlink", "add-caption", "add-footnote",
            "add-endnote", "build-toc", "merge-documents"
          ]
        },
        "risk": { "enum": ["safe", "advanced"] },
        "target": {
          "type": "object",
          "required": ["anchor"],
          "properties": {
            "anchor": { "type": "string", "minLength": 1 },
            "beforeContext": { "type": "string" },
            "afterContext": { "type": "string" }
          },
          "additionalProperties": true
        },
        "expectedMatches": { "type": "integer", "minimum": 0 },
        "before": {},
        "after": {},
        "onFailure": { "enum": ["stop", "skip"] },
        "verify": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "expected"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "expected": {}
          }
        }
      }
    }
  }
}
