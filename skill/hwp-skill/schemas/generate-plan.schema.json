{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/contentriumkorea/hwp-skill/blob/main/skill/hwp-skill/schemas/generate-plan.schema.json",
  "title": "HWP 스킬 새 문서 계획",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "content"],
  "properties": {
    "version": { "const": "1.0" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/paragraph" },
          { "$ref": "#/$defs/table" },
          { "$ref": "#/$defs/field" },
          { "$ref": "#/$defs/image" },
          { "$ref": "#/$defs/pageBreak" }
        ]
      }
    }
  },
  "$defs": {
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string" }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "text"],
      "properties": {
        "row": { "type": "integer", "minimum": 1, "maximum": 100 },
        "column": { "type": "integer", "minimum": 1, "maximum": 100 },
        "text": { "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows", "columns", "cells"],
      "properties": {
        "type": { "const": "table" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 100 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCell" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "value"],
      "properties": {
        "type": { "const": "field" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "label": { "type": "string" },
        "memo": { "type": "string" },
        "display": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "image" },
        "path": { "type": "string", "minLength": 1 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "pageBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "page-break" }
      }
    }
  }
}
