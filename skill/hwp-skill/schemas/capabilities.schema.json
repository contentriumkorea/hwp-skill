{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/contentriumkorea/hwp-skill/blob/main/skill/hwp-skill/schemas/capabilities.schema.json",
  "title": "HWP Backend Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionMode",
    "backends"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "executionMode": {
      "type": "string"
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "available",
          "formats",
          "operations",
          "requiresGui",
          "isolation",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiresGui": {
            "type": "boolean"
          },
          "isolation": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
